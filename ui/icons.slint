// The icons (Chippy's): flat line drawings on a 24 × 24 grid, kept as SVG path
// data so they stay sharp at any size and take the theme's colours. As in
// Carlita, an icon is two paths: `line` is stroked (round ends) and `solid`
// is filled (even-odd). They are drawn as SVG images rasterised on the CPU
// (see icons.rs), which keeps them smooth on every renderer.

export global IconArt {
    pure callback draw(line: string, solid: string, weight: float, grid: float) -> image;
}

