export component Icon inherits Image {
    in property <string> line;
    in property <string> solid;
    in property <brush> tint: white;
    in property <float> weight: 2;
    in property <float> grid: 24;
    width: 24px;
    height: 24px;
    source: IconArt.draw(root.line, root.solid, root.weight, root.grid);
    colorize: root.tint;
    accessible-role: none;
}
